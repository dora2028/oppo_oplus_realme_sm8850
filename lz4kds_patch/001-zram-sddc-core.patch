 static void zram_free_page(struct zram *zram, size_t index)
 {
 	unsigned long handle;
+	u32 prio = zram_get_priority(zram, index);
 
 #ifdef CONFIG_ZRAM_TRACK_ENTRY_ACTIME
 	zram->table[index].ac_time = 0;
@@ -1624,6 +1625,25 @@
 	if (!handle)
 		return;
 
+	/*
+	 * Let the compressor backend observe the payload one last time before
+	 * zsmalloc reclaims it.  LZ4KDS uses this to drop the reference held by
+	 * an alias/delta object; backends without the callback are unaffected.
+	 */
+	if (prio < ZRAM_MAX_COMPS && zram->comps[prio] &&
+	    zram->comps[prio]->ops->release) {
+		struct zcomp *comp = zram->comps[prio];
+		struct zcomp_strm *zstrm;
+		void *payload;
+
+		zstrm = zcomp_stream_get(comp);
+		payload = zs_map_object(zram->mem_pool, handle, ZS_MM_RO);
+		comp->ops->release(comp->params, payload,
+				   zram_get_obj_size(zram, index));
+		zs_unmap_object(zram->mem_pool, handle);
+		zcomp_stream_put(comp);
+	}
+
 	zs_free(zram->mem_pool, handle);
 
 	atomic64_sub(zram_get_obj_size(zram, index),
