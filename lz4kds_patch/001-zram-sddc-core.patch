--- a/drivers/block/zram/Kconfig
+++ b/drivers/block/zram/Kconfig
@@ -26,6 +26,27 @@
 	select LZ4HC_COMPRESS
 	select LZ4_DECOMPRESS
 
+config ZRAM_BACKEND_LZ4KD
+	bool "lz4kd compression support"
+	depends on ZRAM
+	select LZ4KD_COMPRESS
+	select LZ4KD_DECOMPRESS
+	help
+	  Huawei LZ4KD single-page compression.  Faster and denser than LZ4 on
+	  typical Android memory pages.
+
+config ZRAM_BACKEND_LZ4KDS
+	bool "lz4kds (LZ4KD + SDDC) compression support"
+	depends on ZRAM
+	depends on ZRAM_BACKEND_LZ4KD
+	select LZ4KD_COMPRESS
+	select LZ4KD_DECOMPRESS
+	help
+	  LZ4KD plus SDDC similarity/delta compression.  Identical pages are
+	  stored once as an alias and similar pages are stored as a delta against
+	  a resident reference, so pages that differ in only a few bytes compress
+	  far better than with single-page LZ4KD.
+
 config ZRAM_BACKEND_ZSTD
 	bool "zstd compression support"
 	depends on ZRAM
