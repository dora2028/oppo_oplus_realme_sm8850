--- a/drivers/block/zram/zcomp.h
+++ b/drivers/block/zram/zcomp.h
@@ -57,6 +57,16 @@
 	int (*setup_params)(struct zcomp_params *params);
 	void (*release_params)(struct zcomp_params *params);
 
+	/*
+	 * Optional.  Called from zram_free_page() while the stored object is
+	 * still mapped, just before zsmalloc releases it.  Backends that keep
+	 * out-of-band state keyed by the object contents (LZ4KDS reference
+	 * accounting) use this to drop exactly one reference per object.
+	 * Backends that leave it NULL are unaffected.
+	 */
+	void (*release)(struct zcomp_params *params, const void *src,
+			unsigned int src_len);
+
 	const char *name;
 };
 

