--- a/drivers/block/zram/Kconfig
+++ b/drivers/block/zram/Kconfig
@@ -38,6 +38,19 @@
 	select LZ4_COMPRESS
 	select LZ4_DECOMPRESS
 
+config ZRAM_BACKEND_LZ4KDS
+	bool "lz4kds (LZ4KD + SDDC) compression support"
+	depends on ZRAM
+	depends on ZRAM_BACKEND_LZ4KD
+	select LZ4KD_COMPRESS
+	select LZ4KD_DECOMPRESS
+	help
+	  LZ4KD plus SDDC similarity/delta compression.  Pages identical to a
+	  resident reference are stored once as a 5 byte alias and pages that
+	  differ in only a few bytes are stored as a delta against that
+	  reference, so such pages compress far better than with plain LZ4KD.
+	  Pages that match nothing fall back to ordinary LZ4KD.
+
 config ZRAM_BACKEND_ZSTD
 	bool "zstd compression support"
 	depends on ZRAM
@@ -98,6 +111,10 @@
