--- /dev/null
+++ b/drivers/block/zram/lz4kds_sddc.c
@@ -0,0 +1,518 @@
+// SPDX-License-Identifier: GPL-2.0-or-later
+/*
+ * LZ4KDS: LZ4KD + SDDC for the 6.12 zram driver.
+ *
+ * Storage layout
+ * --------------
+ * Every object produced here begins with a one byte kind marker:
+ *
+ *   0x00  LZ4KD single-page stream (ordinary compression)
+ *   0x41  u32 reference id; the page is byte identical to the reference
+ *   0x44  u32 reference id + LZ4KD delta stream against that reference
+ *
+ * A reference holds the *original page* (4 KiB), because the LZ4KD delta
+ * codec operates on raw blocks: lz4kd_encode_delta(state, in0, in, ...) takes
+ * two raw 4 KiB inputs and lz4kd_decode_delta() reconstructs the second one.
+ * Storing compressed payloads as references would make both alias detection
+ * and delta encoding impossible.
+ *
+ * Reference lifetime
+ * ------------------
+ * References are reference counted and only released when the last payload
+ * that points at them is freed.  There is deliberately no eviction: a
+ * payload on disk (or in swap) may still name a reference id, so dropping a
+ * live reference would turn that payload into a dangling pointer.  Memory is
+ * bounded instead by LZ4KDS_REF_BUDGET, and once the budget is reached new
+ * pages simply stop being promoted into references (they still compress
+ * normally).
+ *
+ * zram stores a page verbatim when compression does not fit in less than one
+ * page (comp_len == PAGE_SIZE).  This layer therefore reports PAGE_SIZE for
+ * incompressible pages and never wraps them in a marker.
+ */
+#include <linux/kernel.h>
+#include <linux/slab.h>
+#include <linux/vmalloc.h>
+#include <linux/err.h>
+#include <linux/jhash.h>
+
+#include "lz4kds_sddc.h"
+#include <linux/lz4kd.h>
+
+/* The delta codec works on a 4 KiB block inside an 8 KiB window. */
+#define LZ4KDS_BLOCK_SIZE	SZ_4K
+#define LZ4KDS_WINDOW_SIZE	(2 * LZ4KDS_BLOCK_SIZE)
+
+/* Marker plus reference id. */
+#define LZ4KDS_HDR_ORDINARY	1
+#define LZ4KDS_HDR_REFERENCED	(1 + sizeof(u32))
+
+#define LZ4KDS_KIND_ORDINARY	0x00
+#define LZ4KDS_KIND_ALIAS	0x41
+#define LZ4KDS_KIND_DELTA	0x44
+
+/*
+ * Encoder state size.
+ *
+ * lz4kd_encode_state_bytes_min() reports only what the single-page encoder
+ * needs (8 KiB).  The delta encoder additionally indexes a 1<<13 entry hash
+ * table plus a 1<<5 entry offset chain as uint16_t, i.e.
+ * (8192 + 32) * 2 = 16448 bytes, and it writes past the 8 KiB boundary.
+ * Using the reported minimum with lz4kd_encode_delta() corrupts memory
+ * (verified as a host-side segfault), so the delta-capable state is sized to
+ * 32 KiB here.  This matches the 1<<15 used by the Crystal and vendor LZ4KD
+ * ports.
+ */
+#define LZ4KDS_ENCODE_STATE_BYTES	(1u << 15)
+
+/* Reference budget: bounds resident memory for the reference pages. */
+#define LZ4KDS_REF_MAX		8192
+#define LZ4KDS_REF_BUDGET	(32u * 1024 * 1024)
+#define LZ4KDS_BUCKETS		1024
+
+/* Delta candidates tried per write; encoding runs with the lock held. */
+#define LZ4KDS_DELTA_TRIES	8
+
+struct lz4kds_ref {
+	struct hlist_node node;
+	u32 id;
+	u32 hash;
+	atomic_t users;
+	u8 *page;
+};
+
+struct lz4kds_sddc {
+	spinlock_t lock;
+	struct hlist_head *buckets;
+	u32 nr_buckets;
+	u32 next_id;
+	unsigned int nr_refs;
+	size_t ref_bytes;
+	struct lz4kds_sddc_stats stats;
+};
+
+static inline u32 lz4kds_bucket(u32 hash, u32 nr_buckets)
+{
+	return hash & (nr_buckets - 1);
+}
+
+struct lz4kds_codec *lz4kds_codec_create(void)
+{
+	struct lz4kds_codec *codec;
+
+	codec = kzalloc(sizeof(*codec), GFP_KERNEL);
+	if (!codec)
+		return NULL;
+
+	codec->encode_state = kvzalloc(LZ4KDS_ENCODE_STATE_BYTES, GFP_KERNEL);
+	codec->window = kvzalloc(LZ4KDS_WINDOW_SIZE, GFP_KERNEL);
+	codec->scratch = kvzalloc(2 * LZ4KDS_BLOCK_SIZE, GFP_KERNEL);
+	codec->trial = kvzalloc(2 * LZ4KDS_BLOCK_SIZE, GFP_KERNEL);
+	codec->best = kvzalloc(2 * LZ4KDS_BLOCK_SIZE, GFP_KERNEL);
+	if (!codec->encode_state || !codec->window || !codec->scratch ||
+	    !codec->trial || !codec->best) {
+		lz4kds_codec_destroy(codec);
+		return NULL;
+	}
+
+	return codec;
+}
+
+void lz4kds_codec_destroy(struct lz4kds_codec *codec)
+{
+	if (!codec)
+		return;
+
+	kvfree(codec->best);
+	kvfree(codec->trial);
+	kvfree(codec->scratch);
+	kvfree(codec->window);
+	kvfree(codec->encode_state);
+	kfree(codec);
+}
+
+static u32 lz4kds_hash(const void *buf, unsigned int len)
+{
+	return jhash(buf, len, 0x9e3779b9);
+}
+
+struct lz4kds_sddc *lz4kds_sddc_create(void)
+{
+	struct lz4kds_sddc *sddc;
+
+	/* The delta codec requires 4 KiB pages. */
+	if (PAGE_SIZE != LZ4KDS_BLOCK_SIZE)
+		return ERR_PTR(-EOPNOTSUPP);
+
+	sddc = kzalloc(sizeof(*sddc), GFP_KERNEL);
+	if (!sddc)
+		return ERR_PTR(-ENOMEM);
+
+	sddc->buckets = kvcalloc(LZ4KDS_BUCKETS, sizeof(*sddc->buckets),
+				 GFP_KERNEL);
+	if (!sddc->buckets) {
+		kfree(sddc);
+		return ERR_PTR(-ENOMEM);
+	}
+
+	sddc->nr_buckets = LZ4KDS_BUCKETS;
+	spin_lock_init(&sddc->lock);
+	sddc->next_id = 1;
+
+	return sddc;
+}
+
+void lz4kds_sddc_destroy(struct lz4kds_sddc *sddc)
+{
+	struct lz4kds_ref *ref;
+	struct hlist_node *tmp;
+	u32 i;
+
+	if (!sddc || IS_ERR(sddc))
+		return;
+
+	spin_lock(&sddc->lock);
+	for (i = 0; i < sddc->nr_buckets; i++) {
+		hlist_for_each_entry_safe(ref, tmp, &sddc->buckets[i], node) {
+			hlist_del(&ref->node);
+			sddc->nr_refs--;
+			kvfree(ref->page);
+			kfree(ref);
+		}
+	}
+	spin_unlock(&sddc->lock);
+
+	kvfree(sddc->buckets);
+	kfree(sddc);
+}
+
+/* Byte-identical lookup.  sddc->lock held. */
+static struct lz4kds_ref *lz4kds_ref_lookup_locked(struct lz4kds_sddc *sddc,
+						  const void *src, u32 hash)
+{
+	struct lz4kds_ref *ref;
+
+	hlist_for_each_entry(ref, &sddc->buckets[lz4kds_bucket(hash,
+							      sddc->nr_buckets)],
+			     node) {
+		if (ref->hash != hash)
+			continue;
+		if (!memcmp(ref->page, src, LZ4KDS_BLOCK_SIZE))
+			return ref;
+	}
+
+	return NULL;
+}
+
+static struct lz4kds_ref *lz4kds_ref_find_by_id(struct lz4kds_sddc *sddc,
+						u32 id)
+{
+	struct lz4kds_ref *ref;
+	u32 i;
+
+	for (i = 0; i < sddc->nr_buckets; i++)
+		hlist_for_each_entry(ref, &sddc->buckets[i], node)
+			if (ref->id == id)
+				return ref;
+
+	return NULL;
+}
+
+/* Lock held.  Insert a reference holding a private copy of @page. */
+static struct lz4kds_ref *lz4kds_ref_alloc_locked(struct lz4kds_sddc *sddc,
+						  const void *page, u32 hash)
+{
+	struct lz4kds_ref *ref;
+
+	if (sddc->nr_refs >= LZ4KDS_REF_MAX)
+		return NULL;
+	if (sddc->ref_bytes + LZ4KDS_BLOCK_SIZE > LZ4KDS_REF_BUDGET)
+		return NULL;
+
+	ref = kzalloc(sizeof(*ref), GFP_ATOMIC);
+	if (!ref)
+		return NULL;
+
+	ref->page = kvmalloc(LZ4KDS_BLOCK_SIZE, GFP_ATOMIC);
+	if (!ref->page) {
+		kfree(ref);
+		return NULL;
+	}
+
+	memcpy(ref->page, page, LZ4KDS_BLOCK_SIZE);
+
+	ref->id = sddc->next_id++;
+	if (!ref->id)
+		ref->id = sddc->next_id++;
+	ref->hash = hash;
+	atomic_set(&ref->users, 1);
+	hlist_add_head(&ref->node,
+		       &sddc->buckets[lz4kds_bucket(hash, sddc->nr_buckets)]);
+	sddc->nr_refs++;
+	sddc->ref_bytes += LZ4KDS_BLOCK_SIZE;
+	sddc->stats.ref_allocs++;
+
+	return ref;
+}
+
+/* Lock held. */
+static void lz4kds_ref_put_locked(struct lz4kds_sddc *sddc,
+				  struct lz4kds_ref *ref)
+{
+	if (!ref)
+		return;
+
+	if (!atomic_dec_and_test(&ref->users))
+		return;
+
+	hlist_del(&ref->node);
+	sddc->nr_refs--;
+	sddc->ref_bytes -= LZ4KDS_BLOCK_SIZE;
+	kvfree(ref->page);
+	kfree(ref);
+	sddc->stats.ref_frees++;
+}
+
+/* Lock held. */
+static void lz4kds_ref_get_locked(struct lz4kds_ref *ref)
+{
+	atomic_inc(&ref->users);
+}
+
+int lz4kds_sddc_compress(struct lz4kds_sddc *sddc, struct lz4kds_codec *codec,
+			 const void *src, void *dst, unsigned int *dst_len)
+{
+	unsigned int out_max = *dst_len;
+	struct lz4kds_ref *ref;
+	unsigned int plain_len;
+	u8 *out = dst;
+	u32 hash;
+	int ret;
+
+	if (!sddc || IS_ERR(sddc) || !codec || !src || !dst || !dst_len)
+		return -EINVAL;
+	if (out_max < 2 * LZ4KDS_BLOCK_SIZE)
+		return -EINVAL;
+
+	/* 1. plain LZ4KD compression of this page */
+	ret = lz4kd_encode(codec->encode_state, src, codec->scratch,
+			   LZ4KDS_BLOCK_SIZE, out_max - LZ4KDS_HDR_ORDINARY, 0);
+	if (ret <= 0) {
+		/* Incompressible: let zram store the page verbatim. */
+		*dst_len = LZ4KDS_BLOCK_SIZE;
+		spin_lock(&sddc->lock);
+		sddc->stats.raw++;
+		spin_unlock(&sddc->lock);
+		return 0;
+	}
+	plain_len = ret;
+
+	hash = lz4kds_hash(src, LZ4KDS_BLOCK_SIZE);
+
+	spin_lock(&sddc->lock);
+
+	/* 2. identical page already resident? -> alias */
+	ref = lz4kds_ref_lookup_locked(sddc, src, hash);
+	if (ref) {
+		u32 id = ref->id;
+
+		lz4kds_ref_get_locked(ref);
+		sddc->stats.aliases++;
+		sddc->stats.saved_bytes += plain_len;
+		spin_unlock(&sddc->lock);
+
+		out[0] = LZ4KDS_KIND_ALIAS;
+		memcpy(out + 1, &id, sizeof(id));
+		*dst_len = LZ4KDS_HDR_REFERENCED;
+		return 0;
+	}
+
+	/*
+	 * 3. similar page? -> delta against the best resident reference.
+	 * Delta encoding is expensive and runs under the lock, so only a
+	 * bounded number of candidates is tried per write.  Each attempt
+	 * lands in codec->trial and the winner is snapshotted into
+	 * codec->best so the recorded length always matches the bytes.
+	 */
+	if (sddc->nr_refs) {
+		struct lz4kds_ref *cand;
+		unsigned int best = 0;
+		unsigned int tries = 0;
+		u32 id = 0;
+		u32 b, i;
+
+		b = lz4kds_bucket(hash, sddc->nr_buckets);
+		for (i = 0; i < sddc->nr_buckets && tries < LZ4KDS_DELTA_TRIES;
+		     i++) {
+			u32 idx = (b + i) & (sddc->nr_buckets - 1);
+
+			hlist_for_each_entry(cand, &sddc->buckets[idx], node) {
+				unsigned int dret;
+				u8 *cur;
+
+				if (tries >= LZ4KDS_DELTA_TRIES)
+					break;
+
+				memcpy(codec->window, cand->page,
+				       LZ4KDS_BLOCK_SIZE);
+				memcpy(codec->window + LZ4KDS_BLOCK_SIZE, src,
+				       LZ4KDS_BLOCK_SIZE);
+				cur = codec->window + LZ4KDS_BLOCK_SIZE;
+
+				tries++;
+				sddc->stats.delta_attempts++;
+				dret = lz4kd_encode_delta(codec->encode_state,
+							  codec->window, cur,
+							  codec->trial,
+							  LZ4KDS_BLOCK_SIZE,
+							  LZ4KDS_BLOCK_SIZE,
+							  0);
+				if ((int)dret <= 0)
+					continue;
+				/* Keep the delta only when it beats plain. */
+				if (dret + LZ4KDS_HDR_REFERENCED >= plain_len)
+					continue;
+				if (!best || dret < best) {
+					memcpy(codec->best, codec->trial, dret);
+					best = dret;
+					id = cand->id;
+					ref = cand;
+				}
+			}
+		}
+
+		if (best) {
+			lz4kds_ref_get_locked(ref);
+			sddc->stats.deltas++;
+			sddc->stats.saved_bytes +=
+				plain_len - LZ4KDS_HDR_REFERENCED - best;
+			spin_unlock(&sddc->lock);
+
+			out[0] = LZ4KDS_KIND_DELTA;
+			memcpy(out + 1, &id, sizeof(id));
+			memcpy(out + LZ4KDS_HDR_REFERENCED, codec->best, best);
+			*dst_len = LZ4KDS_HDR_REFERENCED + best;
+			return 0;
+		}
+		sddc->stats.delta_no_gain++;
+	}
+
+	/* 4. plain path; promote this page into the reference table */
+	memcpy(out + LZ4KDS_HDR_ORDINARY, codec->scratch, plain_len);
+	out[0] = LZ4KDS_KIND_ORDINARY;
+	*dst_len = LZ4KDS_HDR_ORDINARY + plain_len;
+	lz4kds_ref_alloc_locked(sddc, src, hash);
+	sddc->stats.ordinary++;
+	spin_unlock(&sddc->lock);
+
+	return 0;
+}
+
+int lz4kds_sddc_decompress(struct lz4kds_sddc *sddc, struct lz4kds_codec *codec,
+			   const void *src, unsigned int src_len, void *dst)
+{
+	const u8 *in = src;
+	struct lz4kds_ref *ref;
+	u32 id;
+	int ret;
+
+	if (!sddc || IS_ERR(sddc) || !codec || !src || !src_len || !dst)
+		return -EINVAL;
+
+	if (in[0] == LZ4KDS_KIND_ORDINARY) {
+		ret = lz4kd_decode(in + LZ4KDS_HDR_ORDINARY, dst,
+				   src_len - LZ4KDS_HDR_ORDINARY,
+				   LZ4KDS_BLOCK_SIZE);
+		if (ret != LZ4KDS_BLOCK_SIZE) {
+			spin_lock(&sddc->lock);
+			sddc->stats.decode_failures++;
+			spin_unlock(&sddc->lock);
+			return -EINVAL;
+		}
+		return 0;
+	}
+
+	if (in[0] != LZ4KDS_KIND_ALIAS && in[0] != LZ4KDS_KIND_DELTA) {
+		spin_lock(&sddc->lock);
+		sddc->stats.decode_failures++;
+		spin_unlock(&sddc->lock);
+		return -EINVAL;
+	}
+	if (src_len < LZ4KDS_HDR_REFERENCED)
+		return -EINVAL;
+
+	memcpy(&id, in + 1, sizeof(id));
+
+	spin_lock(&sddc->lock);
+	ref = lz4kds_ref_find_by_id(sddc, id);
+	if (!ref) {
+		sddc->stats.decode_failures++;
+		spin_unlock(&sddc->lock);
+		return -EINVAL;
+	}
+	lz4kds_ref_get_locked(ref);
+	spin_unlock(&sddc->lock);
+
+	if (in[0] == LZ4KDS_KIND_ALIAS) {
+		memcpy(dst, ref->page, LZ4KDS_BLOCK_SIZE);
+	} else {
+		u8 *cur;
+
+		memcpy(codec->window, ref->page, LZ4KDS_BLOCK_SIZE);
+		cur = codec->window + LZ4KDS_BLOCK_SIZE;
+		memset(cur, 0, LZ4KDS_BLOCK_SIZE);
+		ret = lz4kd_decode_delta(in + LZ4KDS_HDR_REFERENCED,
+					 codec->window, cur,
+					 src_len - LZ4KDS_HDR_REFERENCED,
+					 LZ4KDS_BLOCK_SIZE);
+		if (ret != LZ4KDS_BLOCK_SIZE)
+			goto fail;
+		memcpy(dst, cur, LZ4KDS_BLOCK_SIZE);
+	}
+
+	spin_lock(&sddc->lock);
+	lz4kds_ref_put_locked(sddc, ref);
+	spin_unlock(&sddc->lock);
+	return 0;
+
+fail:
+	spin_lock(&sddc->lock);
+	lz4kds_ref_put_locked(sddc, ref);
+	sddc->stats.decode_failures++;
+	spin_unlock(&sddc->lock);
+	return -EINVAL;
+}
+
+void lz4kds_sddc_put_payload(struct lz4kds_sddc *sddc, const void *src,
+			     unsigned int src_len)
+{
+	const u8 *in = src;
+	struct lz4kds_ref *ref;
+	u32 id;
+
+	if (!sddc || IS_ERR(sddc) || !src || src_len < LZ4KDS_HDR_REFERENCED)
+		return;
+	if (in[0] != LZ4KDS_KIND_ALIAS && in[0] != LZ4KDS_KIND_DELTA)
+		return;
+
+	memcpy(&id, in + 1, sizeof(id));
+
+	spin_lock(&sddc->lock);
+	ref = lz4kds_ref_find_by_id(sddc, id);
+	if (ref)
+		lz4kds_ref_put_locked(sddc, ref);
+	spin_unlock(&sddc->lock);
+}
+
+void lz4kds_sddc_get_stats(struct lz4kds_sddc *sddc,
+			   struct lz4kds_sddc_stats *out)
+{
+	if (!sddc || IS_ERR(sddc) || !out)
+		return;
+
+	spin_lock(&sddc->lock);
+	memcpy(out, &sddc->stats, sizeof(*out));
+	out->nr_refs = sddc->nr_refs;
+	out->ref_bytes = sddc->ref_bytes;
+	spin_unlock(&sddc->lock);
+}
--- /dev/null
+++ b/drivers/block/zram/lz4kds_sddc.h
@@ -0,0 +1,82 @@
+/* SPDX-License-Identifier: GPL-2.0-or-later */
+/*
+ * LZ4KDS: LZ4KD + SDDC (Similarity-Driven Delta Compression) for zram.
+ *
+ * SDDC keeps one resident reference per distinct compressed stream and stores
+ * only an alias (identical page) or a delta (similar page) for every further
+ * object that matches it.  Both representations decode back through the
+ * resident reference, so the read path never walks a chain.
+ *
+ * Every admission failure falls back to ordinary single-page LZ4KD, which
+ * keeps the data path safe when the reference budget or encoder state runs
+ * out.
+ *
+ * Payload layout:
+ *   0x00  LZ4KD single-page stream
+ *   0x41  u32 reference id; the page is byte identical to the reference
+ *   0x44  u32 reference id + LZ4KD delta stream against that reference
+ *
+ * A page that does not compress into less than one page is reported as
+ * PAGE_SIZE and stored verbatim by zram; it never carries a marker and never
+ * reaches the decompressor.
+ *
+ * References live in kernel memory (not zsmalloc) under a fixed budget, so
+ * this layer stays independent of the zram allocator internals.
+ */
+#ifndef _LZ4KDS_SDDC_H
+#define _LZ4KDS_SDDC_H
+
+#include <linux/types.h>
+
+struct lz4kds_sddc;
+
+/* Per-CPU codec state; the zram write path runs with preemption disabled. */
+struct lz4kds_codec {
+	void *encode_state;
+	u8 *window;
+	u8 *scratch;
+	u8 *trial;
+	u8 *best;
+};
+
+struct lz4kds_sddc_stats {
+	u64 aliases;
+	u64 deltas;
+	u64 ordinary;
+	u64 raw;
+	u64 delta_attempts;
+	u64 delta_no_gain;
+	u64 saved_bytes;
+	u64 decode_failures;
+	u64 ref_allocs;
+	u64 ref_frees;
+	u64 ref_evictions;
+	u64 nr_refs;
+	u64 ref_bytes;
+};
+
+struct lz4kds_codec *lz4kds_codec_create(void);
+void lz4kds_codec_destroy(struct lz4kds_codec *codec);
+
+struct lz4kds_sddc *lz4kds_sddc_create(void);
+void lz4kds_sddc_destroy(struct lz4kds_sddc *sddc);
+
+/*
+ * Compress one page.  Returns 0 and fills @dst_len with the payload size, or
+ * PAGE_SIZE in @dst_len when the page must be stored verbatim.
+ */
+int lz4kds_sddc_compress(struct lz4kds_sddc *sddc, struct lz4kds_codec *codec,
+			 const void *src, void *dst, unsigned int *dst_len);
+
+/* Decompress a payload produced by lz4kds_sddc_compress() into one page. */
+int lz4kds_sddc_decompress(struct lz4kds_sddc *sddc, struct lz4kds_codec *codec,
+			   const void *src, unsigned int src_len, void *dst);
+
+/* Drop the reference owned by a payload that is about to be freed. */
+void lz4kds_sddc_put_payload(struct lz4kds_sddc *sddc, const void *src,
+			     unsigned int src_len);
+
+void lz4kds_sddc_get_stats(struct lz4kds_sddc *sddc,
+			   struct lz4kds_sddc_stats *out);
+
+#endif /* _LZ4KDS_SDDC_H */
--- /dev/null
+++ b/drivers/block/zram/backend_lz4kd.c
@@ -0,0 +1,205 @@
+// SPDX-License-Identifier: GPL-2.0-or-later
+/*
+ * zram backend for LZ4KD and LZ4KDS (LZ4KD + SDDC).
+ *
+ *   "lz4kd"   pure Huawei LZ4KD single-page compression
+ *   "lz4kds"  LZ4KD plus SDDC alias/delta representation
+ *
+ * The SDDC reference table is per zcomp instance (per zram device) and is
+ * stored in params->drv_data, which the zcomp API reserves for backend
+ * private data.  Per-CPU scratch state lives in the zcomp context.
+ *
+ * Reference accounting needs one extra hook that the 6.12 zcomp_ops does not
+ * provide: when zram drops a slot it frees the zsmalloc object without ever
+ * looking at its bytes, so an alias/delta payload would keep its reference
+ * forever.  The .release callback added by this patch is called from
+ * zram_free_page() with the still-mapped payload, which lets the SDDC layer
+ * drop exactly one reference per stored object.
+ */
+#include <linux/kernel.h>
+#include <linux/slab.h>
+#include <linux/err.h>
+#include <linux/highmem.h>
+
+#include "backend_lz4kd.h"
+#include "lz4kds_sddc.h"
+#include <linux/lz4kd.h>
+
+static void lz4kd_release_params(struct zcomp_params *params)
+{
+	struct lz4kds_sddc *sddc = params->drv_data;
+
+	if (!sddc)
+		return;
+
+	lz4kds_sddc_destroy(sddc);
+	params->drv_data = NULL;
+}
+
+static int lz4kd_setup_params(struct zcomp_params *params)
+{
+	if (params->level == ZCOMP_PARAM_NO_LEVEL)
+		params->level = 0;
+	return 0;
+}
+
+static void lz4kd_destroy(struct zcomp_ctx *ctx)
+{
+	struct lz4kds_codec *codec = ctx->context;
+
+	if (!codec)
+		return;
+
+	lz4kds_codec_destroy(codec);
+	ctx->context = NULL;
+}
+
+static int lz4kd_create(struct zcomp_params *params, struct zcomp_ctx *ctx)
+{
+	struct lz4kds_codec *codec;
+
+	codec = lz4kds_codec_create();
+	if (!codec)
+		return -ENOMEM;
+
+	ctx->context = codec;
+	return 0;
+}
+
+/*
+ * Create the SDDC table for this zcomp.  setup_params() runs once per zcomp
+ * during device init in process context, so it may sleep.
+ */
+static int lz4kds_setup_params(struct zcomp_params *params)
+{
+	struct lz4kds_sddc *sddc;
+
+	lz4kd_setup_params(params);
+
+	if (params->drv_data)
+		return 0;
+
+	sddc = lz4kds_sddc_create();
+	if (IS_ERR(sddc))
+		return PTR_ERR(sddc);
+
+	params->drv_data = sddc;
+	return 0;
+}
+
+/* ================= LZ4KD (plain) ================= */
+
+static int lz4kd_compress(struct zcomp_params *params, struct zcomp_ctx *ctx,
+			  struct zcomp_req *req)
+{
+	struct lz4kds_codec *codec = ctx->context;
+	int ret;
+
+	if (!codec)
+		return -EINVAL;
+
+	ret = lz4kd_encode(codec->encode_state, req->src, req->dst,
+			   req->src_len, req->dst_len, 0);
+	if (ret < 0)
+		return -EINVAL;
+	if (ret == 0) {
+		/* Incompressible: hand the page back so zram stores it raw. */
+		if (req->dst_len < req->src_len)
+			return -EINVAL;
+		memcpy(req->dst, req->src, req->src_len);
+		req->dst_len = req->src_len;
+		return 0;
+	}
+
+	req->dst_len = ret;
+	return 0;
+}
+
+static int lz4kd_decompress(struct zcomp_params *params, struct zcomp_ctx *ctx,
+			    struct zcomp_req *req)
+{
+	int ret;
+
+	ret = lz4kd_decode(req->src, req->dst, req->src_len, req->dst_len);
+	if (ret != req->dst_len)
+		return -EINVAL;
+
+	return 0;
+}
+
+const struct zcomp_ops backend_lz4kd = {
+	.compress	= lz4kd_compress,
+	.decompress	= lz4kd_decompress,
+	.create_ctx	= lz4kd_create,
+	.destroy_ctx	= lz4kd_destroy,
+	.setup_params	= lz4kd_setup_params,
+	.release_params	= lz4kd_release_params,
+	.name		= "lz4kd",
+};
+
+/* ================= LZ4KDS (LZ4KD + SDDC) ================= */
+
+static int lz4kds_compress(struct zcomp_params *params, struct zcomp_ctx *ctx,
+			   struct zcomp_req *req)
+{
+	struct lz4kds_codec *codec = ctx->context;
+	struct lz4kds_sddc *sddc = params->drv_data;
+	unsigned int out_len;
+	int ret;
+
+	if (!codec || !sddc)
+		return -EINVAL;
+
+	out_len = req->dst_len;
+	ret = lz4kds_sddc_compress(sddc, codec, req->src, req->dst, &out_len);
+	if (ret)
+		return ret;
+
+	req->dst_len = out_len;
+	return 0;
+}
+
+static int lz4kds_decompress(struct zcomp_params *params, struct zcomp_ctx *ctx,
+			     struct zcomp_req *req)
+{
+	struct lz4kds_codec *codec = ctx->context;
+	struct lz4kds_sddc *sddc = params->drv_data;
+	int ret;
+
+	if (!codec || !sddc)
+		return -EINVAL;
+
+	ret = lz4kds_sddc_decompress(sddc, codec, req->src, req->src_len,
+				     req->dst);
+	if (ret)
+		return ret;
+
+	return 0;
+}
+
+/*
+ * Called from zram_free_page() while the object is still mapped.  @src points
+ * at the payload that is about to be released; dropping the reference here
+ * keeps the SDDC table in sync with zram's own object lifetime.
+ */
+static void lz4kds_release(struct zcomp_params *params, const void *src,
+			   unsigned int src_len)
+{
+	struct lz4kds_sddc *sddc = params->drv_data;
+
+	if (!sddc || !src || src_len < 1)
+		return;
+
+	lz4kds_sddc_put_payload(sddc, src, src_len);
+}
+
+const struct zcomp_ops backend_lz4kds = {
+	.compress	= lz4kds_compress,
+	.decompress	= lz4kds_decompress,
+	.create_ctx	= lz4kd_create,
+	.destroy_ctx	= lz4kd_destroy,
+	.setup_params	= lz4kds_setup_params,
+	.release_params	= lz4kd_release_params,
+	.release	= lz4kds_release,
+	.name		= "lz4kds",
+};
